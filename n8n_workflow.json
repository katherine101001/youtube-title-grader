{
  "name": "YouTube Title Optimizer — Agentic AI (5-Layer)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "optimize",
        "responseMode": "responseNode"
      },
      "name": "1. Trigger (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://youtube-title-grader.onrender.com/optimize",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "idea",
              "value": "={{ $json.body.idea }}"
            },
            {
              "name": "category_id",
              "value": "={{ $json.body.category_id || 24 }}"
            }
          ]
        }
      },
      "name": "2. Call Render API",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "You are a YouTube content strategist. Analyze the optimization result below.\nExplain:\n1. In 2-3 sentences, why the winning title scored highest\n2. 1-2 patterns you noticed across rounds\n3. One actionable tip for the creator\nKeep it under 120 words. Be specific and useful."
      },
      "name": "4. AI Agent (Reasoning)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1000,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"idea\": {{ JSON.stringify($(\"2. Call Render API\").first().json.idea) }},\n  \"best_title\": {{ JSON.stringify($(\"2. Call Render API\").first().json.best_title) }},\n  \"best_score\": {{ $(\"2. Call Render API\").first().json.best_score }},\n  \"rounds\": {{ JSON.stringify($(\"2. Call Render API\").first().json.rounds) }},\n  \"ai_analysis\": {{ JSON.stringify($(\"4. AI Agent (Reasoning)\").first().json.output || $(\"4. AI Agent (Reasoning)\").first().json.text) }}\n}"
      },
      "name": "6. Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [
        1500,
        300
      ]
    }
  ],
  "connections": {
    "1. Trigger (Webhook)": {
      "main": [
        [
          {
            "node": "2. Call Model (Render /optimize)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "4. AI Agent (Reasoning)": {
      "main": [
        [
          {
            "node": "6. Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "2. Call Render API": {
      "main": [
        [
          {
            "node": "4. AI Agent (Reasoning)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
